# ====================================================================
# PCMA (Personal Conversation Memory Assistant) - Root .gitignore
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment Configurations & Secrets (NEVER COMMIT)
# --------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.crt
*.der
credentials.json
secrets.json

# --------------------------------------------------------------------
# 2. Local Databases, Audio Recordings & Backups
# --------------------------------------------------------------------
*.db
*.db-*
*.sqlite
*.sqlite3
*.db.bak*
pcma.db*
app.db*
private_audio/
backend/private_audio/
*.enc
*.wav
*.3gp
*.mp3
*.m4a
*.aac
*.flac
*.ogg

# --------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Testing Caches
# --------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.pytest_temp/
backend/.pytest_temp/
tmp_pytest/
backend/tmp_pytest/
.coverage
htmlcov/
.tox/
.nox/
pip-wheel-metadata/

# --------------------------------------------------------------------
# 4. Frontend Dependencies & Build Outputs
# --------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.cache/
.next/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------------
# 5. Android & Gradle Build Artifacts & Machine Configuration
# --------------------------------------------------------------------
.gradle/
android/.gradle/
.kotlin/
android/.kotlin/
build/
android/build/
android/app/build/
*/build/
local.properties
android/local.properties
*.apk
*.ap_
*.aab
*.dex
*.class
captures/
.externalNativeBuild/
android/gradle-8.11.1-bin.zip

# --------------------------------------------------------------------
# 6. IDE & Operating System Files
# --------------------------------------------------------------------
.idea/
android/.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------------------------
# 7. General Logs & Temporary Files
# --------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
*.swp
*~
