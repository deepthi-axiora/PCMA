APP_NAME=Personal Conversation Memory Assistant
APP_VERSION=1.0.0

# Generate 32 random bytes and encode as URL-safe base64. Keep secret outside source control.
AUDIO_ENCRYPTION_KEY=
AUDIO_STORAGE_DIR=./private_audio

# Speech-to-text provider. The API key is only read by the transcription worker.
STT_PROVIDER=openai_whisper
STT_API_KEY=
STT_API_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=90
STT_MAX_ATTEMPTS=3
# Comma-separated language labels returned by the configured provider; set the V1 allowlist.
STT_SUPPORTED_LANGUAGES=

# Diarization provider (http_json or local)
DIARIZATION_PROVIDER=local
DIARIZATION_API_KEY=
DIARIZATION_API_BASE_URL=
DIARIZATION_MODEL=
LOCAL_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
LOCAL_DIARIZATION_DEVICE=cpu
# Hugging Face Access Token required for gated pyannote models
HUGGINGFACE_TOKEN=

DATABASE_URL=postgresql+asyncpg://pcma_user:pcma_password@localhost:5432/pcma_db
